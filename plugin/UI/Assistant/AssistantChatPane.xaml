<UserControl x:Class="revit_mcp_plugin.UI.Assistant.AssistantChatPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="380"
             Background="#F7F8FA"
             FontFamily="Segoe UI"
             AllowDrop="True"
             PreviewDragOver="Attachment_DragOver"
             Drop="Attachment_Drop">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Navy" Color="#1A2744"/>
    <SolidColorBrush x:Key="Steel" Color="#2F5D8A"/>
    <SolidColorBrush x:Key="Accent" Color="#3D7EA6"/>
    <SolidColorBrush x:Key="Soft" Color="#E8EEF4"/>
    <SolidColorBrush x:Key="Muted" Color="#5B6B7C"/>
    <SolidColorBrush x:Key="Line" Color="#D5DEE8"/>
    <SolidColorBrush x:Key="WarnBg" Color="#FFF6E5"/>
    <SolidColorBrush x:Key="WarnBorder" Color="#E0A800"/>
    <!-- Redesign (soft modern chat): header gradient + translucent-on-navy button surfaces,
         card shadows instead of hard borders. Old flat brushes above are untouched so the
         other bubble types (Plan/ToolJournal/AskUser) keep matching without edits. -->
    <SolidColorBrush x:Key="CardBorder" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="HeaderChipFill" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HeaderChipFillHover" Color="#3DFFFFFF"/>
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1A2744" Offset="0"/>
      <GradientStop Color="#284366" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Button" x:Key="ChipButton">
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EEF4FA"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#B9D3E6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
      <Setter Property="Background" Value="{StaticResource Navy}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#1A2744" Opacity="0.28" BlurRadius="10" ShadowDepth="2" Direction="270"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2F5D8A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#C7D3E0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Shared shape for the header's utility buttons (Экспорт/Сценарий/Новый): translucent
         white over the gradient header instead of five duplicated solid-steel templates. -->
    <Style TargetType="Button" x:Key="HeaderChipButton">
      <Setter Property="Margin" Value="0,0,6,4"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource HeaderChipFill}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HeaderChipFillHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Same shape, checkable — Наставник/Запись keep their own "on" color via ToggleButton.Tag,
         read by the shared template below. -->
    <Style TargetType="ToggleButton" x:Key="HeaderChipToggle">
      <Setter Property="Margin" Value="0,0,6,4"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource HeaderChipFill}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HeaderChipFillHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header band -->
    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="14,12">
      <!-- Кнопки вынесены во вторую строку: панель узкая и докируется сбоку,
           в одну строку с заголовком они его зажимали до «AI-ассисте». -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#3D7EA6" Offset="0"/>
              <GradientStop Color="#2F5D8A" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="✦" FontSize="16" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="AI-ассистент" FontSize="15" FontWeight="SemiBold" Foreground="White"
                     TextTrimming="CharacterEllipsis"/>
          <!-- Длинное имя файла раздувало шапку на шесть строк: держим две, остальное в подсказке. -->
          <TextBlock x:Name="ContextText" Text="Вид: —" FontSize="10.5" Foreground="#A8C0D8"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"
                     Margin="0,2,0,0"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="ContextMeterText" Text="Контекст: 0/13" FontSize="10" Foreground="#7A9BB8"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <!-- REV-154: режим наставника. Включён — ассистент объясняет и ведёт по шагам. -->
          <ToggleButton x:Name="TutorModeToggle" Content="🎓 Наставник" Tag="#2E7D52"
                        ToolTip="Режим обучения: ассистент объясняет по шагам и ничего не делает за вас"
                        Style="{StaticResource HeaderChipToggle}"
                        Checked="TutorModeToggle_Changed" Unchecked="TutorModeToggle_Changed"/>
          <!-- REV-177: запись действий для повтора на других уровнях. -->
          <ToggleButton x:Name="RecordActionsToggle" Content="⏺ Запись" Tag="#B33636"
                        ToolTip="Записать следующие действия (стены, двери, окна, отмеченные параметры), чтобы повторить их на других уровнях"
                        Style="{StaticResource HeaderChipToggle}"
                        Checked="RecordActionsToggle_Changed" Unchecked="RecordActionsToggle_Changed"/>
          <Button x:Name="ExportFeedbackButton" Content="📊 0"
                  ToolTip="Собрать жалобы со скриншотами в архив и отправить разработчику"
                  Style="{StaticResource HeaderChipButton}" Padding="8,5"
                  Click="ExportFeedbackButton_Click" Visibility="Collapsed"/>
          <!-- REV-178: сохранить последний запрос из чата как свой чип-сценарий. -->
          <Button x:Name="SaveScenarioButton" Content="💾 Сценарий"
                  ToolTip="Сохранить последний запрос как чип — переживает перезапуск Revit"
                  Style="{StaticResource HeaderChipButton}" Padding="8,5"
                  Click="SaveScenarioButton_Click" IsEnabled="False"/>
          <Button x:Name="NewChatButton" Content="+ Новый"
                  ToolTip="Новый диалог — очистить историю и журнал созданных элементов"
                  Style="{StaticResource HeaderChipButton}" Margin="0,0,8,4"
                  Click="NewChatButton_Click"/>
          <Border x:Name="StatusPill" CornerRadius="12" Padding="10,4" Margin="0,0,0,4"
                  Background="#3D7EA6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" Text="Готов" FontSize="11" FontWeight="SemiBold"
                         Foreground="White"/>
            </StackPanel>
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="12,10,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Server banner -->
      <Border x:Name="ServerBanner" Grid.Row="0" Background="{StaticResource WarnBg}"
              BorderBrush="{StaticResource WarnBorder}" BorderThickness="1,1,1,1"
              CornerRadius="10" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="EnableServerButton" Content="Включить" DockPanel.Dock="Right"
                  Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="8,0,0,0"
                  Click="EnableServerButton_Click"/>
          <StackPanel>
            <TextBlock Text="Сервер команд выключен" FontWeight="SemiBold" FontSize="12"
                       Foreground="{StaticResource Navy}"/>
            <TextBlock Text="Включите, чтобы ассистент мог менять модель."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Chat card -->
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorder}"
              BorderThickness="1" CornerRadius="16" ClipToBounds="True"
              AllowDrop="True" PreviewDragOver="Attachment_DragOver" Drop="Attachment_Drop">
        <Border.Effect>
          <DropShadowEffect Color="#1A2744" Opacity="0.08" BlurRadius="16" ShadowDepth="3" Direction="270"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12,14">
            <StackPanel x:Name="MessagesPanel"/>
          </ScrollViewer>

          <!-- Confirmation bar inside chat card -->
          <Border x:Name="ConfirmBar" Grid.Row="1" Background="{StaticResource WarnBg}"
                  BorderBrush="{StaticResource WarnBorder}" BorderThickness="0,1,0,0"
                  Padding="12,10" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Подтверждение" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
              <TextBlock x:Name="ConfirmText" Text="Подтвердите действие" TextWrapping="Wrap"
                         FontSize="12.5" Foreground="{StaticResource Navy}" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="ConfirmCancel_Click"/>
                <Button x:Name="ConfirmOkButton" Content="Выполнить" Style="{StaticResource PrimaryButton}"
                        Click="ConfirmOk_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Scenarios: collapsible, since they hold ~120px of the pane hostage -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <Button x:Name="ScenariosToggle" HorizontalAlignment="Left" Cursor="Hand"
                Background="Transparent" BorderThickness="0" Padding="2,2,8,6"
                ToolTip="Свернуть или развернуть быстрые сценарии"
                Click="ScenariosToggle_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ScenariosChevron" Text="⌄" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" Width="12"/>
            <TextBlock Text="Быстрые сценарии" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Button>
        <StackPanel x:Name="ScenariosBody">
          <TextBlock Text="Клик — вставить и править · Ctrl+клик — сразу" FontSize="10"
                     Foreground="{StaticResource Muted}" Margin="2,0,0,6" Opacity="0.85"/>
          <WrapPanel x:Name="ChipsPanel"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Composer: floating rounded bar with its own shadow, set off from the page
         instead of a full-bleed strip glued to the bottom edge. -->
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1" CornerRadius="16" Margin="12,10,12,12" Padding="10,10,10,10"
            AllowDrop="True" PreviewDragOver="Attachment_DragOver" Drop="Attachment_Drop">
      <Border.Effect>
        <DropShadowEffect Color="#1A2744" Opacity="0.10" BlurRadius="14" ShadowDepth="2" Direction="270"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="AttachmentStrip" Grid.Row="0" Margin="0,0,0,8"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="AttachButton" Grid.Column="0"
                  Content="📎" ToolTip="Прикрепить файл или перетащить в чат (фото, PDF, Word, Excel…) · Ctrl+V — скрин"
                  Style="{StaticResource GhostButton}" Padding="10,8" Margin="0,0,8,0"
                  VerticalAlignment="Bottom" MinWidth="40" FontSize="16"
                  Click="AttachButton_Click"/>

          <Border x:Name="InputWrapper" Grid.Column="1" Background="#F7FAFC"
                  BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                  CornerRadius="12" Padding="2">
            <TextBox x:Name="InputBox" MinHeight="52" MaxHeight="120"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"
                     Padding="10,8" FontSize="13"
                     VerticalContentAlignment="Top"
                     ToolTip="Enter — отправить · Shift+Enter — новая строка · можно перетащить файл в чат"
                     PreviewKeyDown="InputBox_PreviewKeyDown"
                     GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"/>
          </Border>

          <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom">
            <Button x:Name="SendButton" Content="➤  Отправить" Style="{StaticResource PrimaryButton}"
                    Click="SendButton_Click" Margin="0,0,0,6" MinWidth="110"/>
            <Button x:Name="CancelButton" Content="⏹  Стоп" Style="{StaticResource GhostButton}"
                    Click="CancelButton_Click" IsEnabled="False" MinWidth="110"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
