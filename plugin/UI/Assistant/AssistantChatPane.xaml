<UserControl x:Class="revit_mcp_plugin.UI.Assistant.AssistantChatPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="380"
             Background="#F0F4F8"
             FontFamily="Segoe UI"
             AllowDrop="True"
             PreviewDragOver="Attachment_DragOver"
             Drop="Attachment_Drop">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Navy" Color="#1A2744"/>
    <SolidColorBrush x:Key="Steel" Color="#2F5D8A"/>
    <SolidColorBrush x:Key="Accent" Color="#3D7EA6"/>
    <SolidColorBrush x:Key="Soft" Color="#E8EEF4"/>
    <SolidColorBrush x:Key="Muted" Color="#5B6B7C"/>
    <SolidColorBrush x:Key="Line" Color="#D5DEE8"/>
    <SolidColorBrush x:Key="WarnBg" Color="#FFF6E5"/>
    <SolidColorBrush x:Key="WarnBorder" Color="#E0A800"/>

    <Style TargetType="Button" x:Key="ChipButton">
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E3EEF7"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#3D7EA6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
      <Setter Property="Background" Value="{StaticResource Navy}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2F5D8A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F7FAFC"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header band -->
    <Border Grid.Row="0" Background="{StaticResource Navy}" Padding="14,12">
      <!-- Кнопки вынесены во вторую строку: панель узкая и докируется сбоку,
           в одну строку с заголовком они его зажимали до «AI-ассисте». -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                Background="#2F5D8A" VerticalAlignment="Center">
          <TextBlock Text="✦" FontSize="16" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="AI-ассистент" FontSize="15" FontWeight="SemiBold" Foreground="White"
                     TextTrimming="CharacterEllipsis"/>
          <!-- Длинное имя файла раздувало шапку на шесть строк: держим две, остальное в подсказке. -->
          <TextBlock x:Name="ContextText" Text="Вид: —" FontSize="10.5" Foreground="#A8C0D8"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"
                     Margin="0,2,0,0"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="ContextMeterText" Text="Контекст: 0/13" FontSize="10" Foreground="#7A9BB8"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <!-- REV-154: режим наставника. Включён — ассистент объясняет и ведёт по шагам. -->
          <ToggleButton x:Name="TutorModeToggle" Content="🎓 Наставник"
                        ToolTip="Режим обучения: ассистент объясняет по шагам и ничего не делает за вас"
                        Margin="0,0,6,4" Padding="10,5" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Checked="TutorModeToggle_Changed" Unchecked="TutorModeToggle_Changed"
                        Background="#2F5D8A" Foreground="White" BorderThickness="0">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3D7EA6"/>
                  </Trigger>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#2E7D52"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <!-- REV-177: запись действий для повтора на других уровнях. -->
          <ToggleButton x:Name="RecordActionsToggle" Content="⏺ Запись"
                        ToolTip="Записать следующие действия (стены, двери, окна, отмеченные параметры), чтобы повторить их на других уровнях"
                        Margin="0,0,6,4" Padding="10,5" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Checked="RecordActionsToggle_Changed" Unchecked="RecordActionsToggle_Changed"
                        Background="#2F5D8A" Foreground="White" BorderThickness="0">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3D7EA6"/>
                  </Trigger>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#B33636"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <Button x:Name="ExportFeedbackButton" Content="📊 0"
                  ToolTip="Собрать жалобы со скриншотами в архив и отправить разработчику"
                  Margin="0,0,6,4" Padding="8,5" FontSize="11" FontWeight="SemiBold"
                  Cursor="Hand" Click="ExportFeedbackButton_Click"
                  Background="#2F5D8A" Foreground="White" BorderThickness="0" Visibility="Collapsed">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3D7EA6"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <!-- REV-178: сохранить последний запрос из чата как свой чип-сценарий. -->
          <Button x:Name="SaveScenarioButton" Content="💾 Сценарий"
                  ToolTip="Сохранить последний запрос как чип — переживает перезапуск Revit"
                  Margin="0,0,6,4" Padding="8,5" FontSize="11" FontWeight="SemiBold"
                  Cursor="Hand" Click="SaveScenarioButton_Click" IsEnabled="False"
                  Background="#2F5D8A" Foreground="White" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3D7EA6"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="NewChatButton" Content="+ Новый"
                  ToolTip="Новый диалог — очистить историю и журнал созданных элементов"
                  Margin="0,0,8,4" Padding="10,5" FontSize="11" FontWeight="SemiBold"
                  Cursor="Hand" Click="NewChatButton_Click"
                  Background="#2F5D8A" Foreground="White" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3D7EA6"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Border x:Name="StatusPill" CornerRadius="12" Padding="10,4" Margin="0,0,0,4"
                  Background="#3D7EA6" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Готов" FontSize="11" FontWeight="SemiBold"
                       Foreground="White"/>
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="12,10,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Server banner -->
      <Border x:Name="ServerBanner" Grid.Row="0" Background="{StaticResource WarnBg}"
              BorderBrush="{StaticResource WarnBorder}" BorderThickness="1,1,1,1"
              CornerRadius="10" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="EnableServerButton" Content="Включить" DockPanel.Dock="Right"
                  Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="8,0,0,0"
                  Click="EnableServerButton_Click"/>
          <StackPanel>
            <TextBlock Text="Сервер команд выключен" FontWeight="SemiBold" FontSize="12"
                       Foreground="{StaticResource Navy}"/>
            <TextBlock Text="Включите, чтобы ассистент мог менять модель."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Chat card -->
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="14"
              AllowDrop="True" PreviewDragOver="Attachment_DragOver" Drop="Attachment_Drop">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="10,12">
            <StackPanel x:Name="MessagesPanel"/>
          </ScrollViewer>

          <!-- Confirmation bar inside chat card -->
          <Border x:Name="ConfirmBar" Grid.Row="1" Background="{StaticResource WarnBg}"
                  BorderBrush="{StaticResource WarnBorder}" BorderThickness="0,1,0,0"
                  Padding="12,10" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Подтверждение" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
              <TextBlock x:Name="ConfirmText" Text="Подтвердите действие" TextWrapping="Wrap"
                         FontSize="12.5" Foreground="{StaticResource Navy}" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="ConfirmCancel_Click"/>
                <Button x:Name="ConfirmOkButton" Content="Выполнить" Style="{StaticResource PrimaryButton}"
                        Click="ConfirmOk_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Scenarios: collapsible, since they hold ~120px of the pane hostage -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <Button x:Name="ScenariosToggle" HorizontalAlignment="Left" Cursor="Hand"
                Background="Transparent" BorderThickness="0" Padding="2,2,8,6"
                ToolTip="Свернуть или развернуть быстрые сценарии"
                Click="ScenariosToggle_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ScenariosChevron" Text="⌄" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" Width="12"/>
            <TextBlock Text="Быстрые сценарии" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Button>
        <StackPanel x:Name="ScenariosBody">
          <TextBlock Text="Клик — вставить и править · Ctrl+клик — сразу" FontSize="10"
                     Foreground="{StaticResource Muted}" Margin="2,0,0,6" Opacity="0.85"/>
          <WrapPanel x:Name="ChipsPanel"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Composer -->
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="12,10,12,12"
            AllowDrop="True" PreviewDragOver="Attachment_DragOver" Drop="Attachment_Drop">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="AttachmentStrip" Grid.Row="0" Margin="0,0,0,8"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="AttachButton" Grid.Column="0"
                  Content="📎" ToolTip="Прикрепить файл или перетащить в чат (фото, PDF, Word, Excel…) · Ctrl+V — скрин"
                  Style="{StaticResource GhostButton}" Padding="10,8" Margin="0,0,8,0"
                  VerticalAlignment="Bottom" MinWidth="40" FontSize="16"
                  Click="AttachButton_Click"/>

          <Border Grid.Column="1" Background="#F7FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="12" Padding="2">
            <TextBox x:Name="InputBox" MinHeight="52" MaxHeight="120"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"
                     Padding="10,8" FontSize="13"
                     VerticalContentAlignment="Top"
                     ToolTip="Enter — отправить · Shift+Enter — новая строка · можно перетащить файл в чат"
                     PreviewKeyDown="InputBox_PreviewKeyDown"/>
          </Border>

          <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom">
            <Button x:Name="SendButton" Content="➤  Отправить" Style="{StaticResource PrimaryButton}"
                    Click="SendButton_Click" Margin="0,0,0,6" MinWidth="110"/>
            <Button x:Name="CancelButton" Content="⏹  Стоп" Style="{StaticResource GhostButton}"
                    Click="CancelButton_Click" IsEnabled="False" MinWidth="110"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
