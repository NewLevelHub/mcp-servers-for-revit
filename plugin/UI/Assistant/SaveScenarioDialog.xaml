<Window x:Class="revit_mcp_plugin.UI.Assistant.SaveScenarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сохранить сценарий" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="White">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Название чипа" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBox x:Name="NameBox" Grid.Row="1" FontSize="13" Padding="6" MaxLength="60"/>

    <TextBlock Grid.Row="2" Text="Описание (необязательно, подсказка при наведении)" FontSize="12"
               FontWeight="SemiBold" Margin="0,14,0,4"/>
    <TextBox x:Name="DescriptionBox" Grid.Row="3" FontSize="12" Padding="6" MaxLength="200"
             TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

    <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#B33636" FontSize="11" Margin="0,6,0,0"
               Visibility="Collapsed"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Content="Отмена" Padding="14,6" Margin="0,0,8,0" Click="CancelButton_Click"/>
      <Button x:Name="SaveButton" Content="Сохранить" Padding="14,6" Background="#2F5D8A" Foreground="White"
              BorderThickness="0" Click="SaveButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
